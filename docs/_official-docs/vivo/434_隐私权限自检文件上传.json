ckageName</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"132\" style=\"width: 132px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"129\" style=\"width: 129px\" data-type=\"tableCell\"><p>否</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"352\" style=\"width: 352px\" data-type=\"tableCell\"><p>包名</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"176\" style=\"width: 176px\" data-type=\"tableCell\"><p>serialnumber</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"132\" style=\"width: 132px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"129\" style=\"width: 129px\" data-type=\"tableCell\"><p>否</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"352\" style=\"width: 352px\" data-type=\"tableCell\"><p>文件上传成功的后流水号</p></td></tr></tbody></table><p><br></p><h2 id=\"w1-89977946\">响应示例</h2><pre><code>成功示例：\n{\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"code\":0,\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"msg\":\"成功\"，\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"subCode\"&nbsp;:&nbsp;\"0\",\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"data\":&nbsp;{\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"packageName\":&nbsp;\"com.test.test\",\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"serialnumber\":&nbsp;\"210c5cbc67fdded24245eec7ff5d605c\"\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;}\n}\n\n失败示例：\n{\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"code\":10001,\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"msg\":\"签名校验失败\"\n}\n\n业务失败示例\n{\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"code\":0,\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"subCode\"&nbsp;:&nbsp;\"13001\",\n&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\"msg\":\"上传的文件不存在，上传失败\"\n}</code></pre><p><br></p><h2 id=\"w1-89982291\">业务返回码</h2><table class=\"edit-table\"><tbody><tr><th colspan=\"1\" rowspan=\"1\" colwidth=\"173\" style=\"width: 173px\"><p><strong>返回码</strong></p></th><th colspan=\"1\" rowspan=\"1\" colwidth=\"439\" style=\"width: 439px\"><p><strong>描述</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\