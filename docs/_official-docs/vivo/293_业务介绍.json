"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"214\" style=\"width: 214px\" data-type=\"tableCell\"><p>Jovi语音</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"161\" style=\"width: 161px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"214\" style=\"width: 214px\" data-type=\"tableCell\"><p>阅图锁屏</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"161\" style=\"width: 161px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"214\" style=\"width: 214px\" data-type=\"tableCell\"><p>智慧识图</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"161\" style=\"width: 161px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"214\" style=\"width: 214px\" data-type=\"tableCell\"><p>智慧识屏</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"161\" style=\"width: 161px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"214\" style=\"width: 214px\" data-type=\"tableCell\"><p>短信</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"161\" style=\"width: 161px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"214\" style=\"width: 214px\" data-type=\"tableCell\"><p>扫一扫</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"161\" style=\"width: 161px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p></p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"160\" style=\"width: 160px\" data-type=\"tableCell\"><p>✔</p></td></tr></tbody></table><p></p><h2 id=\"s-cnmcoh77\">1、Jovi主页</h2><p>基于聚合vivo手机中的各项智慧服务，打造多设备协同，多模态交互，全场景链的轻服务闭环体验，Jovi主页中的磁贴、服务、场景服务、我的日程、附近、运动健康、兴趣娱乐等区域都开放出来供服务接入。目前支持数据接入服务。</p><p><img src=\"https://swsdl.vivo.com.cn/appstore/developer/ueditor/20200309/20200309110912054640.jpg\" alt=\"Jovi主页场景.jpg\" title=\"Jovi主页场景.jpg\" data-natural-width=\"1142\" data-natural-height=\"606\" data-type=\"image\"></p><h2 id=\"s-eyoczb1p\">2、Jovi语音</h2><p>基于对话形式直接为用户提供的内容和服务。目前支持数据接入、直达应用。</p><p><img src=\"https://swsdl.vivo.com.cn/appstore/developer/ueditor/20200309/20200309110927156758.jpg\" alt=\"Jovi语音场景.jpg\" title=\"Jovi语音场景.jpg\" data-natural-width=\"571\" data-natural-height=\"606\" data-type=\"image\"></p><h2 id=\"s-qntk3wtb\">3、智慧桌面</h2><p>智慧桌面即负一屏，支持开发者应用产品的卡片化显示，开发者可根据自身产品的需求，设计和开发卡片内容，为开发者提高推广效率，并为用户提供方便快捷的服务。目前支持直达应用、jovi卡片服务。</p><p><img src=\"https://swsdl.vivo.com.cn/appstore/developer/uploadFile/20240408/5vpbxr/20240408101615772599.png\" data-natural-width=\"570\" data-natural-height=\"606\" data-type=\"image\"></p><h2 id=\"s-4boy4yzu\">4、全局搜索</h2><p>全局搜索是直接触达内容与服务的快捷核心搜索入口，由vivo负责根据用户搜索请求以及相关的内容数据，以相应的界面形式进行展现。目前支持数据接入服务。<br><img src=\"https://swsdl.vivo.com.cn/appstore/developer/uploadFile/20240408/wd3gnz/20240408101654711124.png\" data-natural-width=\"580\" data-natural-height=\"606\" data-type=\"image\"></p><p><br></p><h1 id=\"s-rhhgmt2k\">五、接入流程</h1><p>为保障服务正常上架，开发者在服务接入前，需提前与平台客服人员联系，沟通合作方式，明确服务接入形式和服务上架的流量入口。若沟通前，服务已提交审核，则直达应用服务默认分发到全局搜索；Jovi卡片默认分发到智慧桌面。实际上架情况以审核结果为准。</p><p><img src=\"https://swsdl.vivo.com.cn/appstore/developer/ueditor/20200721/20200721175542378552.jpg\" alt=\"服务接入流程.jpg\" title=\"服务接入流程.jpg\" data-natural-width=\"868\" data-natural-height=\"375\" data-type=\"image\"></p><p><br></p><h1 id=\"s-p3trfp6i\">六、能力支持</h1><p>快应用厂商提供账号授权和用户信息获取的能力，开发者可以调用vivo手机号获取接口，以获取用户授权后的手机号码。借用此能力，用户可使用vivo账号绑定的手机号码进行一键登录，或者手动输入其他手机号，通过短信验证码登录。详情见：<a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://dev.vivo.com.cn/documentCenter/doc/139\">快应用账号接入文档</a></p><p>服务平台建议开发者使用此能力，方便用户进行一键登录，使快应用承载的服务（例如Jovi卡片），操作更加便捷。同时，支持用户一键登录的服务，也将优先获得平台的流量扶持。</p><p></p><p><strong>一键登录能力价值：</strong></p><p>1、优质体验：用户免输手机号，操作便利，体验更优；</p><p>2、登录稳定：用户无需获取验证码，避免出现短信接收失败等质量问题；</p><p>3、提升转化：开发者借助便捷的登录流程，提升新用户转化率；</p><p>4、功能全面：开发者除了获取手机号码，还可获取用户头像和昵称。<br></p><p><br></p><p><strong>更多平台动态、疑问解答、客服咨询，请您关注Jovi服务平台官方公众号：</strong></p><p><img src=\"https://swsdl.vivo.com.cn/appstore/developer/ueditor/20200417/20200417103121064152.jpg\" alt=\"Jovi微信公众号二维码8cm.jpg\" title=\"Jovi微信公众号二维码8cm.jpg\" data-natural-width=\"258\" data-natural-height=\"258\" data-type=\"image\"></p>","versionCode":9,"updateTime":1691461747000,"breadCrumbs":"Jovi服务平台,业务介绍","docType":3,"docMessageType":"service_distribution"}}