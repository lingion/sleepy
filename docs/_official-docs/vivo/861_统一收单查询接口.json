h colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\"><p><strong>说明</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>tradeOrderNo</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>订单号</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>merchantOrderNo</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>商户订单号</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>tradeStatus</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>状态：pending 支付中 success 成功&nbsp; closed 关闭</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>tradeAmount</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>订单金额，单位为分</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>totalPayAmount</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>支付金额(扣减V钻、卡券等优惠金额)，单位为分</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>currencyType</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>货币</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>paymentTime</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>支付时间 yyyyMMddHHmmss</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>tradeType</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>交易类型</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>orderType</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>订单类型，1普通订单，2代扣订单； 快应用业务当前只有1</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>failMsg</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>失败原因 (新添加)</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"182\" style=\"width: 182px\" data-type=\"tableCell\"><p>paymentInfos</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"153\" style=\"width: 153px\" data-type=\"tableCell\"><p>List</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>支付信息(数组) 详见3.2</p></td></tr></tbody></table><h2 id=\"s-1a96s3sx\">2、paymentInfos 内容</h2><table class=\"edit-table\"><tbody><tr><th colspan=\"1\" rowspan=\"1\" colwidth=\"185\" style=\"width: 185px\"><p><strong>字段</strong></p></th><th colspan=\"1\" rowspan=\"1\" colwidth=\"152\" style=\"width: 152px\"><p><strong>数据类型</strong></p></th><th colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\"><p><strong>说明</strong></p></th></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"185\" style=\"width: 185px\" data-type=\"tableCell\"><p>paymentWayCode</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"152\" style=\"width: 152px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>支付方式编码</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"185\" style=\"width: 185px\" data-type=\"tableCell\"><p>payAmount</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"152\" style=\"width: 152px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>支付金额，单位为分</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"185\" style=\"width: 185px\" data-type=\"tableCell\"><p>bankName</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"152\" style=\"width: 152px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>银行名称，只有银行卡支付方式才会返回</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"185\" style=\"width: 185px\" data-type=\"tableCell\"><p>bankCode</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"152\" style=\"width: 152px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>银卡编码，只有银行卡支付方式才会返回</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"185\" style=\"width: 185px\" data-type=\"tableCell\"><p>cardType</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"152\" style=\"width: 152px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>卡类型，只有银行卡支付方式才会返回</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\" colwidth=\"185\" style=\"width: 185px\" data-type=\"tableCell\"><p>cardNo</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"152\" style=\"width: 152px\" data-type=\"tableCell\"><p>String</p></td><td colspan=\"1\" rowspan=\"1\" colwidth=\"571\" style=\"width: 571px\" data-type=\"tableCell\"><p>卡号，只有银行卡支付方式才会返回</p></td></tr></tbody></table><h1 id=\"s-1udazplo\"><br>四、备注</h1><h2 id=\"s-5zp0q28k\">1、请求示例</h2><pre><code>public class VivopayTradeQueryDemo {\n    public static void main(String[] args) throws VivopayApiException {\n        VivoClient vivoClient = new DefaultVivoClient(\"RSA\", 应用私钥, vivo支付平台公钥，http网关请求地址, \"UTF-8\");\n        VivopayTradeQueryV2Request request = new VivopayTradeQueryV2Request();\n        request.setAppId(appid);\n        request.setTimestamp(new Date());\n        request.setBizModel(getBizModel());\n        VivopayTradeQueryV2Response response = vivoClient.execute(request);\n        if (response.isSuccess()) {\n            System.out.println(\"调用成功:\" + JSON.toJSONString(response));\n        } else {\n            System.out.println(\"调用失败:\" + JSON.toJSONString(response));\n        }\n    }\n    public static VivopayTradeQueryV2Model getBizModel() {\n        VivopayTradeQueryV2Model bizModel = new VivopayTradeQueryV2Model();\n        bizModel.setTradeOrderNo(\"20240624636388951469056\");\n        return bizModel;\n    }\n}</code></pre><p></p><h2 id=\"s-12ewrxw2\">2、响应示例</h2><pre><code>{\n    \"msg\": \"success\",\n    \"code\": \"10000\",\n    \"bizMsg\": \"SUCCESS\",\n    \"bizCode\": \"S\",\n    \"sign\": \"\",\n    \"signType\": \"RSA\",\n    \"resultContent\": \"{\\\"