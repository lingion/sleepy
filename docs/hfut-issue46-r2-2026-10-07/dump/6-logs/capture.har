gs -->\n    <!--<title layout:title-pattern=\"$DECORATOR_TITLE - $CONTENT_TITLE\" th:text=\"#{system.title}\">教务系统<\/title>-->\n\n    <link rel=\"icon\" href=\"\/eams5-student\/static\/favicon.png\" \/>\n    <link rel=\"stylesheet\" href=\"\/eams5-student\/static\/eams-ui\/css\/eams-ui.min.css?v=00011\" \/>\n    <link rel=\"stylesheet\" href=\"\/eams5-student\/static\/eams-ui\/css\/eams-ui-plugin.min.css?v=00010\" \/>\n    <link rel=\"stylesheet\" href=\"\/eams5-student\/static\/helper\/css\/info-page.css?v=00005\" \/>\n    <link rel=\"stylesheet\" href=\"\/eams5-student\/static\/helper\/css\/generate-template.css?v=00002\" \/>\n    <link rel=\"stylesheet\" href=\"\/eams5-student\/static\/eams-ui\/css\/default.css?v=00010\" \/>\n    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->\n    <!-- WARNING: Respond.js doesn't work if you view the page via file:\/\/ -->\n    <!--[if lt IE 9]>\n    <script src=\"\/eams5-student\/static\/eams-ui\/js\/html5shiv.min.js?v=00002\"><\/script>\n    <script src=\"\/eams5-student\/static\/eams-ui\/js\/respond.min.js?v=00002\"><\/script>\n    <![endif]-->\n\n    <script src=\"\/eams5-student\/static\/eams-ui\/js\/eams-ui.js?v=00011\"><\/script>\n    <script src=\"\/eams5-student\/static\/eams-ui\/js\/eams-ui.zh.min.js?v=00002\"><\/script>\n    <script src=\"\/eams5-student\/static\/eams-ui\/js\/iconfont.js\"><\/script>\n    <script>\n      \/\/ 设置 context path, js会需要用\n      window.CONTEXT_PATH = '\/eams5-student';\n      window.LOCALE = 'zh';\n    <\/script>\n    <!--<script type=\"text\/javascript\" th:src=\"@{\/static\/system\/global-variable.js?v=00002}\"><\/script>-->\n    <script type=\"text\/javascript\" src=\"\/eams5-student\/static\/helper\/search-page-helper1.js?v=00003\"><\/script>\n    <script type=\"text\/javascript\" src=\"\/eams5-student\/static\/helper\/notIndex-page-helper.js?v=00003\"><\/script>\n    <script type=\"text\/javascript\" src=\"\/eams5-student\/static\/helper\/info-page.js?v=00003\"><\/script>\n    <script type=\"text\/javascript\" src=\"\/eams5-student\/static\/helper\/student-selectize.js?v=00004\"><\/script>\n    <script type=\"text\/javascript\" src=\"\/eams5-student\/static\/helper\/datatable-column-tools.js?v=20260722\"><\/script>\n    <script>\n      \/*<![CDATA[*\/\n      $(function () {\n\n        $.triggerParentEvent = function() {\n          var parentWindow = window.parent;\n          while (parentWindow.name !== 'root-window' && parentWindow !== parentWindow.parent) {\n            parentWindow = parentWindow.parent\n          }\n          parentWindow.$.fn.trigger.apply(parentWindow.$(parentWindow),Array.prototype.slice.call(arguments));\n        }\n\n        var infoMessages = null;\n        if (!infoMessages) {\n          infoMessages = [];\n        }\n        $.each(infoMessages, function (index, message) {\n          new PNotify({\n            title: '消息',\n            text: message,\n            type: 'info',\n            delay: 1000\n          });\n        });\n\n        var successMessages = null;\n        if (!successMessages) {\n          successMessages = [];\n        }\n        $.each(successMessages, function (index, message) {\n          new PNotify({\n            title: '成功',\n            text: message,\n            type: 'success',\n            delay: 1000\n          });\n        });\n\n        var errorMessages = null;\n        if (!errorMessages) {\n          errorMessages = [];\n        }\n        $.each(errorMessages, function (index, message) {\n          new PNotify({\n            title: '错误',\n            text: message,\n            type: 'error',\n            delay: 5000\n          });\n        });\n\n        var noticeMessages = null;\n        if (!noticeMessages) {\n          noticeMessages = [];\n        }\n        $.each(noticeMessages, function (index, message) {\n          new PNotify({\n            title: '提示',\n            text: message,\n            type: 'notice',\n            delay: 1000\n          });\n        });\n\n        $(document).ajaxError(function (event, request) {\n\n          if (request.responseText && request.status == 200 && request.statusText == \"parsererror\") {\n            window.location.href = self.location.href;\n          }\n\n          if (!request.responseJSON) {\n            return;\n          }\n\n          var texts = [];\n          var message = request.responseJSON.message;\n          if (request.responseJSON.errors && request.responseJSON.errors.length > 0) {\n            message = request.responseJSON.errors[0].defaultMessage;\n          }\n\n          texts.push(\"exception:\\t\" + request.responseJSON.exception);\n          texts.push(\"message:\\t\" + message);\n          texts.push(\"path:\\t\" + request.responseJSON.path);\n          texts.push(\"status:\\t\" + request.responseJSON.status);\n          texts.push(\"timestamp:\\t\" + new Date(request.responseJSON.timestamp));\n\n          new PNotify({\n            title: request.responseJSON.error,\n            text: texts.join(\"\\n\"),\n            type: 'error',\n            delay: 50000,\n            width: '600px',\n            min_height: '150px'\n          });\n\n        });\n\n      $(\"body\").on(\"click\", \".online-btn\", function () {\n        var dataId = $(this).closest(\"li\").attr(\"data-id\");\n        window.open(window.CONTEXT_PATH + '\/file\/common\/preview-by-open-key\/' + dataId, \"_blank\");\n      });\n      $(\"body\").on(\"click\", \".download\", function () {\n        var dataId = $(this).closest(\"li\").attr(\"data-id\");\n        FormUtil.get({\n          form: $(\"<form><\/form>\"),\n          url: window.CONTEXT_PATH + '\/file\/common\/download-by-open-key\/' + dataId\n        });\n      });\n\n    });\n\n    \/\/ 重写表单校验remote\n    $.validator.addMethod(\"remoteCheck\", function (value, element, param) {\n      var result = false;\n      $.get($.extend({\n        async: false,\n        success: function (response) {\n          result = response;\n        }\n      }, param));\n      return result;\n    }, function (param) {\n      return param.message;\n    });\n\n    $.validator.addMethod('maxScale', function (value, element, param) {\n      var result = (value.match('\\^\\-\\?\\\\d+\\.\\?\\\\d{0,' + param.scale + '}$'));\n      return this.optional(element) || result;\n    }, function (param) {\n      return \"小数位数最多\" + param.scale + \"位\";\n    });\n\n      window.preventFromSubmitTwice = function ($form) {\n        $form.each(function () {\n          $(this).submit(function () {\n            let hasValidator = $(this).data('validator') !== undefined;\n            if (hasValidator && !$(this).valid()) {\n              return false;\n            }\n\n            $(this).find(\":submit\").button('loading');\n            $(this).submit(function () {\n              if ($(this).data('validator') && $(this).data('validator').formSubmitted) {\n                \/\/解决remote那种提交\n                $(this).find(\":submit\").button('loading');\n                return true;\n              }\n              return false;\n            });\n            return true;\n\n          })\n        })\n      };\n      window.preventFromSubmitTwice($('#save-form'));\n\n      window.semesterURIUtil = function (originalUri, insertBefore, semesterId) {\n        var semesterPattern = \"\/semester\/\";\n        if (originalUri.indexOf(semesterPattern) != -1) {\n          \/\/ remove semester pattern\n          var semesterPatternStartAt = originalUri.indexOf(semesterPattern);\n          var semesterPatternEndAt = semesterPatternStartAt +\n              originalUri.substring(semesterPatternStartAt, originalUri.length).indexOf(\"\/\", semesterPattern.length);\n          originalUri = originalUri.substring(0, semesterPatternStartAt) + originalUri.substring(semesterPatternEndAt, originalUri.length);\n        }\n        var appendIndex = originalUri.indexOf(insertBefore);\n        return originalUri.substring(0, appendIndex) + semesterPattern + semesterId + originalUri.substring(appendIndex, originalUri.length);\n      };\n      document.ondrop = function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n      }\n\n\n      \/\/    eamsUiUtil.cascadeScrollParentWindowToTop(window);\n      \/*]]>*\/\n    <\/script>\n    <style>\n      .selectize-dropdown {\n        width: auto !important;\n        min-width: 100%;\n      }\n\n    .selectize-dropdown-content > div.option {\n      white-space: nowrap;\n    }\n\n    .accessory-info{\n      font-size: 14px;\n      color: #330099;\n      font-weight: bold;\n    }\n    .accessory-list{\n      padding: 0;\n      text-decoration: underline;\n      text-decoration-color: #0090ff;\n    }\n    .accessory-list .download{\n      cursor: pointer;\n    }\n    .accessory-list li{\n      list-style-type: none;\n      margin-bottom: 5px;\n      padding-top: 1px;\n    }\n    .accessory-list .online-btn{\n      height: 16px;\n      font-size: 12px;\n      box-sizing: border-box;\n      line-height: 1;\n      padding-top: 0;\n      padding-bottom: 0;\n      margin-left: 7px;\n      cursor: pointer;\n    }\n  <\/style>\n  \t<link rel=\"stylesheet\" href=\"\/eams5-student\/static\/scheduletable\/css\/schedule-table.css\" \/>\n  \t<script src=\"\/eams5-student\/static\/eams-ui\/js\/require.js\"><\/script>\n  \t<script src=\"\/eams5-student\/static\/scheduletable\/js\/main.js\"><\/script>\n  \t<style>\n    span.form-control-next {\n      display: block;\n      padding: 6px 0px;\n    }\n  <\/style>\n<\/head>\n\n  <body>\n\n<div class=\"container\">\n  <div class=\"row\">\n    <div class=\"top-bar\">\n      <h2 class=\"info-title\" style=\"width:auto;\">\n        吴勇勋(2024218261)\n      <\/h2>\n      <div class=\"pull-right\">\n        <button class=\"btn btn-primary\" type=\"button\" id=\"totalCourses\">全部课程<\/button>\n        <button class=\"btn btn-primary\" type=\"button\" id=\"toPrintPage\">打印<\/button>\n        <button class=\"btn