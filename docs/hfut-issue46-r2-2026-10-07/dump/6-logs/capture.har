plate.html","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"content":{"size":287,"text":"<div class=\"card-content\">\n  <strong style=\"color: #737373\">\n    <% if (activityType == 'Exam') { %>\n      考试\n    <% } else if (activityType == 'RoomBorrow') { %>\n      教室借用\n    <% } %>\n  <\/strong>\n  <p>\n    <%= activityName %><br\/>\n    (<%= weekIndices %>)周\n  <\/p>\n<\/div>\n","mimeType":"application\/octet-stream"},"redirectURL":"","headersSize":-1,"bodySize":287},"cache":{},"timings":{"send":0,"wait":0,"receive":0}},{"startedDateTime":"1970-01-01T00:00:00.000Z","time":0,"request":{"method":"GET","url":"\/eams5-student\/static\/scheduletable\/js\/templates\/warn-card-template.html","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"content":{"size":648,"text":"<div class=\"card-content\">\n  <span style=\"color: #ff6b6b\">\n    <% for (var i=0; i < conflictTypes.length; i++) { %>\n      <% if (conflictTypes[i] == 'Person') { %>\n      <div style=\"color: blue;\">\n        <i class=\"fa fa-exclamation-triangle\"><\/i>教师占用\n      <\/div>\n      <% } else if (conflictTypes[i] == 'Room') { %>\n      <div style=\"color: red;\">\n        <i class=\"fa fa-exclamation-triangle\"><\/i>教室占用\n      <\/div>\n      <% } else if (conflictTypes[i] == 'Adminclass') { %>\n      <div style=\"color: yellow;\">\n        <i class=\"fa fa-exclamation-triangle\"><\/i>班级占用\n      <\/div>\n      <% } %>\n    <% } %>\n  <\/span>\n<\/div>\n\n","mimeType":"application\/octet-stream"},"redirectURL":"","headersSize":-1,"bodySize":648},"cache":{},"timings":{"send":0,"wait":0,"receive":0}},{"startedDateTime":"1970-01-01T00:00:00.000Z","time":0,"request":{"method":"GET","url":"\/eams5-student\/static\/scheduletable\/js\/templates\/room-table-warn-template.html","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"content":{"size":185,"text":"<div class=\"room-table-content\">\n  教室占用:<%- rootName %>\n  <p>\n    <i class=\"fa fa-th-large\"><\/i>\n    <%= activityType %><%= activityName %>(<%- weekIndices %>周)\n  <\/p>\n<\/div>\n","mimeType":"application\/octet-stream"},"redirectURL":"","headersSize":-1,"bodySize":185},"cache":{},"timings":{"send":0,"wait":0,"receive":0}},{"startedDateTime":"1970-01-01T00:00:00.000Z","time":0,"request":{"method":"GET","url":"\/eams5-student\/static\/scheduletable\/js\/templates\/card-popover-content.html","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"content":{"size":648,"text":"<% _.each(teachers, function(teacher) { %>\n<h4>\n  <a class=\"fa fa-user\"><\/a>&nbsp;\n  <% if (teacher.id || teacher.personId) { %>\n    <%= teacher.personName %>\n  <% } else { %>\n    未安排教师\n  <% } %>\n<\/h4>\n<div class=\"arranges\">\n  <% if (!teacher.arranges || teacher.arranges.length == 0) { %>\n    <p>未排课或未安排教室<\/p>\n  <% } %>\n  <% _.each(teacher.arranges, function(arrange, index) { %>\n\n  <p>\n    <%= arrange.campusName %>&nbsp;<%= arrange.buildingName %>&nbsp;\n    <%= arrange.roomName %>(<%= arrange.weekIndices %>周)\n  <\/p>\n\n  <% }); %>\n<\/div>\n<% }); %>\n<div style=\"margin-left: 15px;\">组号:<%= scheduleGroupNo %><\/div>","mimeType":"application\/octet-stream"},"redirectURL":"","headersSize":-1,"bodySize":648},"cache":{},"timings":{"send":0,"wait":0,"receive":0}},{"startedDateTime":"1970-01-01T00:00:00.000Z","time":0,"request":{"method":"GET","url":"\/eams5-student\/static\/scheduletable\/js\/templates\/warn-card-popover.html","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"content":{"size":1635,"text":"<%\n  var index = 0;\n  var conflictDataLength = 0;\n  for (var i in popoverData.conflictDatas) {\n    var conflictData = popoverData.conflictDatas[i];\n    var rootClass = conflictData.rootClass;\n\n    var end = index +  conflictData.activities.length;\n    if ((index >= popoverData.pageStart && index < popoverData.pageEnd) ||\n        (end >= popoverData.pageStart && end < popoverData.pageEnd) ||\n        (index < popoverData.pageEnd && end >= popoverData.pageEnd)\n      ) {\n%>\n    <div class=\"conflict-activity\">\n  <%\n    } else {\n  %>\n      <div class=\"conflict-activity\" style=\"display: none\">\n  <% } %>\n      <b>\n        <% if (rootClass == \"Person\") { %>\n          教师占用:\n        <% } else if (rootClass == \"Room\") { %>\n          教室占用:\n        <% } else if (rootClass == \"Adminclass\") { %>\n          班级占用:\n        <% } %>\n        &nbsp;<%= conflictData.rootName %>\n      <\/b>\n      <%\n      $.each(conflictData.activities, function() {\n        if (index < popoverData.pageStart || index >= popoverData.pageEnd) {\n          index ++;\n          return true;\n        }\n      %>\n        <div class=\"arranges\">\n          <p>\n            <i class=\"fa fa-th-large\"><\/i>\n            <%= this.activityType %>\n            <%= this.activityName %>\n            (<%= this.weekIndices %>周)\n          <\/p>\n        <\/div>\n      <%\n        index ++;\n      });\n      %>\n    <\/div>\n<%\n  }\n%>\n\n<div class=\"row\">\n  <div class=\"col col-sm-6 text-right\"><button class=\"btn btn-link text-muted previous-page\">上一页<\/button><\/div>\n  <div class=\"col col-sm-6\"><button class=\"btn btn-link next-page\">下一页<\/button><\/div>\n<\/div>","mimeType":"application\/octet-stream"},"redirectURL":"","headersSize":-1,"bodySize":1635},"cache":{},"timings":{"send":0,"wait":0,"receive":0}},{"startedDateTime":"1970-01-01T00:00:00.000Z","time":0,"request":{"method":"GET","url":"\/eams5-student\/static\/scheduletable\/js\/templates\/schedule-template.html","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"content":{"size":2656,"text":"<% if (selected) { %>\n  <div class=\"td-selected text-center\"><span>选中<\/span><\/div>\n<% } %>\n<% if (conflictInfo) {\n    var title = conflictInfo.replace(\"Person\", \"教师占用\").replace(\"Room\", \"教室占用\").replace(\"Adminclass\", \"班级占用\").replace(\"practiceWeek\", \"实践专周\");\n%>\n<div title=\"<%=title%>\" class=\"td-conflict text-right\" style=\"padding-right: 30px;\">\n  <span><%=title%><\/span>\n<\/div>\n<% } %>\n<%\n  if (lessonTypeInfo) {\n    var lessonTypeStr = lessonTypeInfo.replace(\"THEORY\", \"理论\").replace(\"EXPERIMENT\", \"实验\").replace(\"PRACTICE\", \"实践\").replace(\"TEST\", \"习题\").replace(\"MACHINE\", \"上机\").replace(\"DESIGN\", \"设计\")\n%>\n<div class=\"lesson-type-span text-right\">\n  <span><%=lessonTypeStr%><\/span>\n<\/div>\n<% } %>\n<% if (holiday) { %>\n  <div title=\"<%=holiday %>\" class=\"td-conflict text-right\" style=\"padding-right: 30px;\"><span><%= holiday %><\/span><\/div>\n<% } %>\n<% if (lessThanCurrentSemester) { %>\n  <div title=\"不属于本学期\" class=\"td-conflict text-right\" style=\"padding-right: 30px;\"><span>不属于本学期<\/span><\/div>\n<% } %>\n\n<% if (!batch) { %>\n  <% if (schedule) { %>\n    <% if (schedule.get('room') && schedule.get('room').id) { %>\n      <i class=\"fa fa-home arrange-icon\"><\/i>&nbsp;<%= schedule.get('room').building.campus.nameZh %>&nbsp;<%= schedule.get('room').nameZh %>\n    <% } else if (schedule.get('customPlace') && schedule.get('customPlace') != '') { %>\n      <i class=\"fa fa-home arrange-icon\"><\/i>&nbsp;<%= schedule.get('customPlace') %>\n    <% } else { %>\n      <i class=\"fa fa-exclamation-circle undo-arrange-icon\"><\/i>&nbsp;未安排教室\n    <% } %>\n  <% } else { %>\n      <i class=\"fa fa-minus-circle donot-arrange-icon\"><\/i>&nbsp;此周不排课\n  <% } %>\n<% } else { %>\n  <% if (schedules.length > 0) { %>\n    <%\n      var arranged = true;\n      for (var i=0; i < schedules.length; i++) {\n        if (!schedules.models[i].get('room') || !schedules.models[i].get('room').id) {\n          arranged = false;\n          break;\n        }\n      }\n      if (arranged) {\n    %>\n      <i class=\"fa fa-home arrange-icon\"><\/i>&nbsp;<%= schedules.models[0].get('room').building.campus.nameZh %>&nbsp;<%= schedules.models[0].get('room').nameZh %>\n      <% } else if (schedules.models[0].get('customPlace') && schedules.models[0].get('customPlace') != '') { %>\n       <i class=\"fa fa-home arrange-icon\"><\/i>&nbsp;<%= schedules.models[0].get('customPlace') %>\n      <% } else { %>\n       <i class=\"fa fa-exclamation-circle undo-arrange-icon\"><\/i>&nbsp;未安排教室\n    <% } %>\n  <% } else { %>\n    <i class=\"fa fa-minus-circle donot-arrange-icon\"><\/i>&nbsp;此周不排课\n  <% } %>\n<% } %>","mimeType":"application\/octet-stream"},"redirectURL":"","headersSize":-1,"bodySize":2656},"cache":{},"timings":{"send":0,"wait":0,"receive":0}},{"startedDateTime":"1970-01-01T00:00:00.000Z","time":0,"request":{"method":"GET","url":"\/eams5-student\/static\/scheduletable\/js\/templates\/extend-card-popover.html","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP\/1.1","cookies":[],"headers":[],"content":{"size":62,"text":"<h4>\n  <%= activityName %><br\/>\n  <%= weekIndices %>周\n<\/h4>\n","mimeType":"application\/octet-stream"},"redirectURL":"","headersSize":-1,"bodySize":62},"cache":{},"timings":{"send":0,"wait":0,"receive":0}},{"startedDateTime":"1970-01-01T00:00:00.000Z","time":0,"request":{"method":"GET","url":"\/eams5-student\/static\/scheduletable\/js\/templates\/room