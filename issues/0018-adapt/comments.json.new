[{"url":"https://api.github.com/repos/lingion/sleepy/issues/comments/5563272784","html_url":"https://github.com/lingion/sleepy/issues/18#issuecomment-5563272784","issue_url":"https://api.github.com/repos/lingion/sleepy/issues/18","id":5563272784,"node_id":"IC_kwDOS8keYs8AAAABS5jOUA","user":{"login":"lingion","id":165679819,"node_id":"U_kgDOCeASyw","avatar_url":"https://avatars.githubusercontent.com/u/165679819?v=4","gravatar_id":"","url":"https://api.github.com/users/lingion","html_url":"https://github.com/lingion","followers_url":"https://api.github.com/users/lingion/followers","following_url":"https://api.github.com/users/lingion/following{/other_user}","gists_url":"https://api.github.com/users/lingion/gists{/gist_id}","starred_url":"https://api.github.com/users/lingion/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lingion/subscriptions","organizations_url":"https://api.github.com/users/lingion/orgs","repos_url":"https://api.github.com/users/lingion/repos","events_url":"https://api.github.com/users/lingion/events{/privacy}","received_events_url":"https://api.github.com/users/lingion/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-07T00:13:28Z","updated_at":"2026-09-07T00:13:28Z","body":"收到中科院大学的适配请求。你提供的教务地址是 `xkgo.ucas.ac.cn:3000/course/personSchedule`，采集包也收到了。\n\n你提供的课程里没有详细周次，这不是你的问题，是我这边的抓取工具没有把这部分数据正确取出来。我正在用其他公开项目做交叉验证，继续适配中科院大学的教务系统。","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/lingion/sleepy/issues/comments/5563272784/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/lingion/sleepy/issues/comments/5572263275","html_url":"https://github.com/lingion/sleepy/issues/18#issuecomment-5572263275","issue_url":"https://api.github.com/repos/lingion/sleepy/issues/18","id":5572263275,"node_id":"IC_kwDOS8keYs8AAAABTCH9aw","user":{"login":"damifan3","id":118594746,"node_id":"U_kgDOBxGcug","avatar_url":"https://avatars.githubusercontent.com/u/118594746?v=4","gravatar_id":"","url":"https://api.github.com/users/damifan3","html_url":"https://github.com/damifan3","followers_url":"https://api.github.com/users/damifan3/followers","following_url":"https://api.github.com/users/damifan3/following{/other_user}","gists_url":"https://api.github.com/users/damifan3/gists{/gist_id}","starred_url":"https://api.github.com/users/damifan3/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/damifan3/subscriptions","organizations_url":"https://api.github.com/users/damifan3/orgs","repos_url":"https://api.github.com/users/damifan3/repos","events_url":"https://api.github.com/users/damifan3/events{/privacy}","received_events_url":"https://api.github.com/users/damifan3/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-07T14:41:03Z","updated_at":"2026-09-07T14:41:33Z","body":"> 收到中科院大学的适配请求。你提供的教务地址是 `xkgo.ucas.ac.cn:3000/course/personSchedule`，采集包也收到了。\n> \n> 你提供的课程里没有详细周次，这不是你的问题，是我这边的抓取工具没有把这部分数据正确取出来。我正在用其他公开项目做交叉验证，继续适配中科院大学的教务系统。\n\n原html中，点击课表中的每个课程，进去就是详细周次。\n似乎你的打包工具会将整个网页递归打包，按理说应该有每个课程的详细周次","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/lingion/sleepy/issues/comments/5572263275/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/lingion/sleepy/issues/comments/5573459220","html_url":"https://github.com/lingion/sleepy/issues/18#issuecomment-5573459220","issue_url":"https://api.github.com/repos/lingion/sleepy/issues/18","id":5573459220,"node_id":"IC_kwDOS8keYs8AAAABTDQ9FA","user":{"login":"lingion","id":165679819,"node_id":"U_kgDOCeASyw","avatar_url":"https://avatars.githubusercontent.com/u/165679819?v=4","gravatar_id":"","url":"https://api.github.com/users/lingion","html_url":"https://github.com/lingion","followers_url":"https://api.github.com/users/lingion/followers","following_url":"https://api.github.com/users/lingion/following{/other_user}","gists_url":"https://api.github.com/users/lingion/gists{/gist_id}","starred_url":"https://api.github.com/users/lingion/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lingion/subscriptions","organizations_url":"https://api.github.com/users/lingion/orgs","repos_url":"https://api.github.com/users/lingion/repos","events_url":"https://api.github.com/users/lingion/events{/privacy}","received_events_url":"https://api.github.com/users/lingion/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-07T16:32:38Z","updated_at":"2026-09-07T16:32:38Z","body":"你说得对，课程详情页里确实有详细周次。上一个版本的采集器本身存在抓取问题，可能导致课程详情中的周次没有被完整采集，这不是你的采集包或操作问题。\n\n如果方便的话，麻烦你重新下载最新的采集器 v1.2，登录课表后重新采集一次，再把新的采集包发到这个 issue。v1.2 已针对上一版本抓不到课程周次的问题进行了修复，我会根据新的采集包继续确认解析结果。谢谢！","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/lingion/sleepy/issues/comments/5573459220/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/lingion/sleepy/issues/comments/5586739148","html_url":"https://github.com/lingion/sleepy/issues/18#issuecomment-5586739148","issue_url":"https://api.github.com/repos/lingion/sleepy/issues/18","id":5586739148,"node_id":"IC_kwDOS8keYs8AAAABTP7fzA","user":{"login":"damifan3","id":118594746,"node_id":"U_kgDOBxGcug","avatar_url":"https://avatars.githubusercontent.com/u/118594746?v=4","gravatar_id":"","url":"https://api.github.com/users/damifan3","html_url":"https://github.com/damifan3","followers_url":"https://api.github.com/users/damifan3/followers","following_url":"https://api.github.com/users/damifan3/following{/other_user}","gists_url":"https://api.githu