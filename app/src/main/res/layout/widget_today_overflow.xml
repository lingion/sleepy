<?xml version="1.0" encoding="utf-8"?>
<!-- Today overflow v7 (2026-09-10 用户定稿: 「最近两日的那个小组件它怎么做你就怎么做,
     然后在上面加一个切换的 bar」):
     滚动层 1:1 抄 widget_scroll_twoday (壳图 ImageView + 条带 ListView 的 FrameLayout,
     同一台 OPPO 真机一直正常滚动) — 壳图按容器尺寸渲染, 条带异步加载期间兜底不闪空。
     bar 行 = 36dp 三键 ‹ 当前日期 ›, 竖排在上与滚动层同级不叠压;
     标题 weight=1 + ellipsize → 任意拉缩只截断标题, 三键永不被挤出。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_overflow_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_scroll_clip"
    android:outlineProvider="background"
    android:clipToOutline="true">

    <!-- bar 行 36dp = NAV_HEADER_H_DP 渲染器口径; 按钮 40x28dp = 视图即点击热区 -->
    <LinearLayout
        android:id="@+id/widget_today_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/widget_today_nav_prev"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="@string/today_nav_prev_day" />

        <!-- 中键 = 当前显示日期, 点按 = 回到今天 (三键定稿的第三键收进日期文本)。
             weight=1 吃掉全部剩余宽: 窄卡上标题截断而不是把 › 挤出可视区。 -->
        <TextView
            android:id="@+id/widget_today_nav_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="13sp"
            android:contentDescription="@string/today_nav_back_to_today" />

        <ImageView
            android:id="@+id/widget_today_nav_next"
            android:layout_width="40dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="@string/today_nav_next_day" />
    </LinearLayout>

    <!-- 滚动层 = widget_scroll_twoday 逐行同构: 壳图 + 条带 ListView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_shell"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:adjustViewBounds="false" />

        <ListView
            android:id="@+id/widget_strip_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"
            android:cacheColorHint="@android:color/transparent"
            android:listSelector="@android:color/transparent"
            android:contentDescription="@string/widget_week_grid_label" />
    </FrameLayout>
</LinearLayout>
