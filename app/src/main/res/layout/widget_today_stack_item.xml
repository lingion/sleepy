<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程 StackView 卡片行 (issue #24 交互改造)。
     每卡 = renderToday 按容器尺寸整卡渲染的 bitmap (TodayStackService 惰性渲染 + LruCache),
     内容高度闸门 (TodayStackCore.staticFits) 保证卡面内容不压底部导航条区域。
     点击卡面 = 合并进容器的 PendingIntentTemplate (打开 App)。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_stack_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_week_grid_label" />
</FrameLayout>
