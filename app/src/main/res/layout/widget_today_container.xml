<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程静态容器 (issue #24 Feature2 日期导航) — bitmap + 三个透明点击区。
     FrameLayout 后声明者在上层: nav_today(全宽标题条带) 在下, prev/next(角落) 在上 →
     角落点击优先命中 prev/next; 条带其余区域 = 「回到今天」(R3 点日期区回今天)。
     bitmap 保底 open-app: 标题条带以下区域点击 = 打开 App。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false"
        android:contentDescription="@string/widget_week_grid_label" />
    <!-- 三个透明点击区必须用 RemoteViews 白名单类 (ImageView 有 @RemoteView 注解;
         裸 View 无注解 → launcher 端 RemoteViews.apply inflate 抛异常 →
         「载入窗口小组件时出现问题」, 见 issue #24 回归)。 -->
    <ImageView
        android:id="@+id/widget_today_nav_today"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/today_nav_back_to_today" />
    <ImageView
        android:id="@+id/widget_today_nav_prev"
        android:layout_width="36dp"
        android:layout_height="30dp"
        android:layout_gravity="start|top"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/today_nav_prev_day" />
    <ImageView
        android:id="@+id/widget_today_nav_next"
        android:layout_width="36dp"
        android:layout_height="30dp"
        android:layout_gravity="end|top"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/today_nav_next_day" />
</FrameLayout>
