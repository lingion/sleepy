<?xml version="1.0" encoding="utf-8"?>
<!-- 可滚动 Today — 壳图(原渲染器按容器尺寸渲染: 圆角背景+首屏内容) + 条带 ListView。
     FrameLayout clipToOutline 圆角裁剪 → 条带方形角被裁掉, 露出壳的圆角背景。
     条带与壳同源同坐标系 → 滚动位置 0 与主分支静态渲染逐像素一致。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_scroll_clip"
    android:outlineProvider="background"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/widget_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false" />
    <!-- v9.3 已知退化 (评估后不修): resize 拖拽期间 host view 连续变化, 壳图只按
         最后 commit 尺寸渲染 → 拖拽中途 fitXY 会短暂拉伸旧壳, 新 commit 落地即恢复。
         根因是 commit-vs-drag 时序 (世代闸刻意丢弃中间提交), 非任何 scaleType 可解:
         fitCenter 会把旧壳缩出黑边, 更差。世代闸收敛语义保留, 在此留档。 -->
    <ListView
        android:id="@+id/widget_strip_list"
        android:overScrollMode="never"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:cacheColorHint="@android:color/transparent"
        android:listSelector="@android:color/transparent" />
</FrameLayout>
