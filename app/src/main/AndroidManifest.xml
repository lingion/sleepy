<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions: 仅课程表所需 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SleepyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sleepy"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Sleepy.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 外部 app (文件管理器、邮件附件、其他课表 app) 通过 ACTION_VIEW 打开课表文件时:
             1. OpenJsonAlias (alias of ImportReceiverActivity) 接收 intent
             2. ImportReceiverActivity 读取文件内容并透传到 MainActivity
             3. MainActivity 解析后挂到 companion.pendingImportText, ImportSheet 自动弹预览
             单独拆分避免 MainActivity 既有 LAUNCHER 又有 VIEW 时的 launchMode/singleTask 边界问题
             MIME 覆盖 ScheduleParser 全部内容嗅探分派格式 (issue #6): 文件管理器把
             .html/.ics/.csv 报成对应 MIME 时 Sleepy 才会出现在"打开方式"候选里;
             parse() 按内容分派与 MIME 无关, 这里只需保证文件进得来。
             🚫禁注册二进制类型 (octet-stream/pdf/zip/image...): readText() 读二进制
             会 OOM, 且 content:// 的 pathPattern 匹配不到文件名 — 垃圾 intent 收益为零。
             ManifestExternalOpenFilterTest 锁定此注册面。 -->
        <activity
            android:name=".ui.screen.imports.ImportReceiverActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sleepy.Splash" />

        <activity-alias
            android:name=".OpenJsonAlias"
            android:targetActivity=".ui.screen.imports.ImportReceiverActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <!-- WakeUp JSON 导出 -->
                <data android:mimeType="application/json" />
                <!-- WakeUp 分享文本 / 纯文本课表 -->
                <data android:mimeType="text/plain" />
                <!-- 教务系统 HTML 表格 (issue #6 主诉) -->
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
                <!-- ICS 日历课表 (Sleepy 自身导出 .ics 就是 text/calendar) -->
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <!-- CSV 课表 (部分 ROM 报 legacy 别名) -->
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <!-- XML 起头页面走 parse() 的 <?xml / <!doctype 分支 -->
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
        </activity-alias>

        <!-- App Widget Receivers -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TodaySmallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_small_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekListWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_list_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekListSmallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_list_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_list_small_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekViewWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_view_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_view_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekViewSmallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_view_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_view_small_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekGridWidgetProvider"
            android:exported="true"
            android:label="@string/widget_week_grid_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_grid_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TwoDayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_twoday_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/twoday_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TwoDaySmallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_twoday_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/twoday_small_widget_info" />
        </receiver>

        <!-- Daily boot receiver: reschedule notifications -->
        <receiver
            android:name=".widget.notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Daily course notification receiver (alarm target) -->
        <receiver
            android:name=".widget.notification.DailyNotifyReceiver"
            android:exported="false" />

        <!-- Before-class midnight scheduler -->
        <receiver
            android:name=".widget.notification.BeforeClassScheduleReceiver"
            android:exported="false" />

        <!-- Individual before-class notification -->
        <receiver
            android:name=".widget.notification.BeforeClassNotifyReceiver"
            android:exported="true" />

        <!-- 教务直连导入 Activity (v1.0.8 新增) -->
        <activity
            android:name=".ui.screen.imports.JwImportActivity"
            android:exported="false"
            android:label="教务直连导入"
            android:theme="@style/Theme.Sleepy" />

        <!-- WeekGridWidget 预览 Activity (debug only, 用于在 emulator 截图验证) -->
        <activity
            android:name=".widget.WeekGridPreviewActivity"
            android:exported="true"
            android:label="Widget 预览"
            android:theme="@style/Theme.Sleepy" />

        <!-- Pin widget to home (adb automation) -->
        <activity
            android:name=".widget.PinWidgetActivity"
            android:exported="true"
            android:label="Pin Widget"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- 真实 widget bitmap 渲染验证 (debug only, 渲染 RemoteViews Canvas bitmap 用于截图) -->
        <activity
            android:name=".widget.WidgetRenderActivity"
            android:exported="true"
            android:label="Widget Render"
            android:theme="@style/Theme.Sleepy" />

        <!-- debug 组件（DebugImportReceiver / DebugScheduleReceiver）已移至 src/debug 源集，
             仅 debug 构建包含，release APK 完全不含这些测试入口。 -->

        <!-- Fluid cloud foreground service carrier -->
        <service
            android:name=".widget.notification.FluidCloudService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 可滚动 widget (v1.0.36): 条带 RemoteViewsService, Launcher 绑定拉行 -->
        <service
            android:name=".widget.ScrollStripService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>
