diff --git a/app/src/main/java/com/lingion/sleepy/widget/RemoteViewsWidgetHelper.kt b/app/src/main/java/com/lingion/sleepy/widget/RemoteViewsWidgetHelper.kt
index 924d1ce..9e78235 100644
--- a/app/src/main/java/com/lingion/sleepy/widget/RemoteViewsWidgetHelper.kt
+++ b/app/src/main/java/com/lingion/sleepy/widget/RemoteViewsWidgetHelper.kt
@@ -90,4 +90,55 @@ object RemoteViewsWidgetHelper {
         bmp.recycle()
         Log.d(tag, "renderAndPush id=$widgetId ${wDp}x${hDp}dp → ${wPx}x${hPx}px")
     }
+
+    /**
+     * ★ 可滚动 widget (v1.0.36) — ListView 集合视图推送。
+     *
+     * 静态 bitmap 物理不可滚 → 改 RemoteViewsService 绑定:
+     * setRemoteAdapter(ListView) + setPendingIntentTemplate(行点击模板)。
+     * 推送后 notifyAppWidgetViewDataChanged 触发 Factory 重新加载数据。
+     *
+     * @param headerSetup 往 views 塞头部 bitmap/背景等静态部分 (各 widget 不同, 无则 null)
+     * @param serviceCls RemoteViewsService 子类 (行工厂入口)
+     * @param scopeExtra 行工厂数据范围 (Today 用 "today"; TwoDay 两列两个 ListView)
+     */
+    fun pushScrollable(
+        context: Context,
+        awm: AppWidgetManager,
+        widgetId: Int,
+        layoutRes: Int,
+        listRes: Int,
+        serviceCls: Class<*>,
+        scopeExtra: String?,
+        tag: String,
+        headerSetup: ((RemoteViews, Float, Float) -> Unit)? = null
+    ) {
+        val opts = awm.getAppWidgetOptions(widgetId)
+        val (wDp, hDp) = computeSizeDp(opts)
+
+        val views = RemoteViews(context.packageName, layoutRes)
+        headerSetup?.invoke(views, wDp.toFloat(), hDp.toFloat())
+
+        // 绑定 RemoteViewsService → Launcher 进程拉行数据
+        val svcIntent = Intent(context, serviceCls).apply {
+            putExtra(TodayListService.CourseRowFactory.EXTRA_WIDGET_ID, widgetId)
+            data = android.net.Uri.parse(toUri(Intent.URI_INTENT_SCHEME))
+        }
+        if (scopeExtra != null) svcIntent.putExtra(TodayListService.CourseRowFactory.EXTRA_SCOPE, scopeExtra)
+        views.setRemoteAdapter(listRes, svcIntent)
+
+        // 行点击模板 — 点击任一行打开 MainActivity (FillInIntent 合并)
+        val template = PendingIntent.getActivity(
+            context, widgetId,
+            Intent(context, MainActivity::class.java).apply {
+                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+            },
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+        views.setPendingIntentTemplate(listRes, template)
+
+        awm.updateAppWidget(widgetId, views)
+        awm.notifyAppWidgetViewDataChanged(widgetId, listRes)
+        Log.d(tag, "pushScrollable id=$widgetId ${wDp}x${hDp}dp scope=$scopeExtra")
+    }
 }
