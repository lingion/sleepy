+     * 课程结束时刻判定: ownTime 用 startTime/endTime, 否则查 timeJson 节点表;
+     * 解析失败(查不到节点)的课保守视为"未结束", 宁可多显示不漏课。
+     */
+    fun filterRecentCourses(courses: List<CourseEntity>, range: Int, timeJson: String, now: java.time.LocalTime): List<CourseEntity> {
+        if (range <= 0 || courses.isEmpty()) return courses
+        val upcoming = courses.filter { course ->
+            val end = if (course.ownTime && course.endTime.isNotBlank()) {
+                runCatching { java.time.LocalTime.parse(course.endTime) }.getOrNull()
+            } else {
+                TimeTableUtils.courseTimeParts(
+                    courseStartNode = course.startNode,
+                    courseStep = course.step,
+                    timeJson = timeJson,
+                    ownTime = course.ownTime,
+                    startTime = course.startTime,
+                    endTime = course.endTime
+                )?.second?.let { runCatching { java.time.LocalTime.parse(it) }.getOrNull() }
+            }
+            // 结束时刻解析失败 → 视为未结束(宁可多显示)
+            end == null || end.isAfter(now)
+        }
+        return upcoming.take(range)
+    }
